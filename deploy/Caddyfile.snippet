# ─────────────────────────────────────────────
# The Girl House — toko thrifting
# Blok ini ditambahkan ke /etc/caddy/Caddyfile milik VPS,
# lalu jalankan: systemctl reload caddy
# App berjalan sebagai container Docker di 127.0.0.1:8095.
# Caddy otomatis memasang HTTPS (Let's Encrypt) untuk domain di bawah.
# ─────────────────────────────────────────────
thegirlhouse.duckdns.org {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8095
}
