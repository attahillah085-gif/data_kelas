# =========================================================
#  ThriftFlow — contoh konfigurasi environment
#  Salin file ini menjadi ".env" lalu sesuaikan nilainya.
#      cp .env.example .env
# =========================================================

# Kunci rahasia untuk enkripsi session (WAJIB diganti di produksi!)
# Buat kunci acak:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-kunci-acak-yang-panjang

# Koneksi database.
# Default: SQLite (otomatis, tanpa setup). Untuk produksi disarankan PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/thriftflow
# DATABASE_URL=sqlite:///thriftflow.db

# Akun owner pertama (dibuat otomatis saat "python seed.py")
OWNER_NAME=Pemilik
OWNER_EMAIL=owner@thriftflow.id
OWNER_PASSWORD=owner123

# --- Web Push (opsional) ---
# Buat sepasang kunci VAPID:  python seed.py --vapid
# Lalu tempel hasilnya di sini agar notifikasi push aktif.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@thriftflow.id
